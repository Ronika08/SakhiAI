# Frontend environment (Vite) — copy to .env.local.   Only PUBLIC values belong here.
# NEVER put API keys (Gemini, Google Maps server key, JWT secret) in any VITE_* variable:
# everything prefixed VITE_ is embedded in the public JavaScript bundle.
#
#   [REQUIRED-PROD]  VITE_API_BASE_URL — absolute https URL of the backend (build-time).
#   [OFFLINE-ONLY]   the offline features (rules, local knowledge, translations, trackers,
#                    GPS, voice via the browser) need no variable at all.
VITE_API_BASE_URL=http://localhost:5000
