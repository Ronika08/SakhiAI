# ============================================================================
# SakhiAI backend environment — copy to backend/.env   (NEVER commit .env)
# Every value below is a PLACEHOLDER. Put real secrets only in backend/.env.
#
# Legend
#   [REQUIRED]        the server cannot do its job without it
#   [REQUIRED-PROD]   required when NODE_ENV=production (optional in development)
#   [OPTIONAL]        sensible default exists / feature is simply off when blank
#   [PROD]            only matters in production
#   [OFFLINE-ONLY]    n/a — the app's offline features (rules, local knowledge, trackers,
#                     GPS, SMS composer, voice via the browser) need NO server variable
# ============================================================================

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000                                  # [OPTIONAL] default 5000
NODE_ENV=development                       # [OPTIONAL] "production" enables strict checks
CORS_ALLOWED_ORIGINS=http://localhost:5173 # [REQUIRED-PROD] comma-separated exact frontend origins (https in prod)
APP_URL=http://localhost:5173              # [REQUIRED-PROD] frontend URL, used in password-reset e-mails
TRUST_PROXY=0                              # [PROD] 1 behind Render/Railway/Fly/Heroku/Nginx (correct rate limiting)
LOG_LEVEL=debug                            # [OPTIONAL] error|warn|info|debug (default info in production)

# ── Database (MongoDB) ──────────────────────────────────────────────────────
# Without it, chat / health tips / offline features still work; accounts, sync and server SOS do not.
MONGODB_URI=mongodb://127.0.0.1:27017/sakhiai   # [REQUIRED-PROD] free option: MongoDB Atlas M0

# ── Authentication ──────────────────────────────────────────────────────────
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars   # [REQUIRED-PROD] >= 32 chars
JWT_ACCESS_EXPIRES_IN=15m                  # [OPTIONAL]
REFRESH_TOKEN_DAYS=30                      # [OPTIONAL]
PASSWORD_RESET_MINUTES=30                  # [OPTIONAL]
BCRYPT_ROUNDS=12                           # [OPTIONAL] 4-15

# ── AI: Gemini is the primary ONLINE fallback (never the default path) ──────
DEFAULT_AI_PROVIDER=gemini                 # [OPTIONAL] gemini | anthropic | openai(stub)
GEMINI_API_KEY=your-gemini-api-key-here    # [REQUIRED-PROD] only to enable the AI fallback; server-side only
# Backend-owned model — the frontend can never choose it. Use a CURRENT model; Gemini 1.5/2.0 are shut
# down and gemini-2.5-flash is scheduled for shutdown on 2026-10-16.
GEMINI_MODEL=gemini-3.5-flash              # [OPTIONAL]
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite # [OPTIONAL] used on 404 / 429; leave empty to disable
GEMINI_TIMEOUT_MS=20000                    # [OPTIONAL]
GEMINI_MAX_RETRIES=1                       # [OPTIONAL] transient failures only (0-3)
AI_MAX_OUTPUT_TOKENS=1024                  # [OPTIONAL]
AI_MAX_HISTORY_MESSAGES=20                 # [OPTIONAL]
AI_MAX_MESSAGE_CHARS=2000                  # [OPTIONAL]
ANTHROPIC_API_KEY=                         # [OPTIONAL] secondary provider
ANTHROPIC_MODEL=claude-sonnet-4-6          # [OPTIONAL]
OPENAI_API_KEY=                            # [OPTIONAL] stub, not implemented
OPENAI_MODEL=gpt-4o-mini                   # [OPTIONAL]

# ── Optional ONLINE speech-to-text fallback (voice input) ───────────────────
# Voice input uses the browser/device speech recognition first (no server involved). Only browsers
# WITHOUT it can use this fallback, which records audio and sends it to Gemini. OFF by default.
VOICE_STT_ENABLED=false                    # [OPTIONAL] true to enable (needs GEMINI_API_KEY)
VOICE_MAX_AUDIO_BYTES=1500000              # [OPTIONAL]

# ── Google Maps (server-side, Safe Route planning + geocoding) ──────────────
# Restrict this key to the Directions + Geocoding APIs and to your server's IP in Google Cloud.
# The live-map / nearby links in the app are keyless embeds and need no key.
GOOGLE_MAPS_API_KEY=your-google-maps-server-key-here   # [OPTIONAL] route search is disabled without it

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000                # [OPTIONAL]
RATE_LIMIT_MAX=300                         # [OPTIONAL]

# ============================================================================
# SOS / alert notifications — all FREE options, all [OPTIONAL].
# If none is configured SakhiAI reports NOT_CONFIGURED honestly and never claims
# a contact was notified. "SENT" only means a provider ACCEPTED the message.
# ============================================================================

# 1) Webhook(s): https://ntfy.sh/<private-topic>, a Discord/Slack incoming webhook, Make/Zapier/n8n.
NOTIFY_WEBHOOK_URLS=                       # comma-separated, https only
NOTIFY_WEBHOOK_SECRET=                     # optional HMAC signature secret
NOTIFY_TIMEOUT_MS=8000

# 2) E-mail — choose ONE transport (both have free tiers). Also used for password-reset e-mails.
RESEND_API_KEY=                            # a) Resend HTTPS API
EMAIL_FROM=
SMTP_HOST=                                 # b) any SMTP server (Gmail app password, Brevo, Mailjet, ...)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# 3) Web Push (free). Generate keys:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
