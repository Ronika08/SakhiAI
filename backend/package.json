{
  "name": "sakhiai-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend API server for SakhiAI — provider-independent AI chat, health, and safety services.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node --check server.js && node --check app.js",
    "validate:env": "node scripts/validateEnv.js",
    "check:gemini": "node scripts/checkGemini.js"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "nodemailer": "^10.0.16",
    "sakhiai": "file:..",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
