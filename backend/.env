# =============================================================================
# SakhiAI Backend — Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- Server -------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Comma-separated list of origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database (optional for now — MongoDB integration is a pending feature) --
MONGODB_URI=

# --- Authentication (optional for now — JWT auth is a pending feature) ------
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- AI Providers ---------------------------------------------------------
# Which provider services/aiProvider.js uses when a request doesn't specify one.
# Options: anthropic | openai | gemini
DEFAULT_AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Logging ----------------------------------------------------------------
# Options: error | warn | info | debug
LOG_LEVEL=debug
